# ==============================================================================
# LANCERPULSE ENVIRONMENT CONFIGURATION
# Copy this file to .env and configure values for your deployment target
# ==============================================================================

# Core Settings
DEBUG=False
SECRET_KEY=generate-a-strong-random-secret-key-for-production-here!

# Allowed Hosts (comma-separated list of domains)
# Example: ALLOWED_HOSTS=lancerpulse.com,www.lancerpulse.com,lancerpulse.up.railway.app
ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0

# CSRF Trusted Origins (comma-separated origins with protocol)
# Example: CSRF_TRUSTED_ORIGINS=https://lancerpulse.com,https://lancerpulse.up.railway.app
CSRF_TRUSTED_ORIGINS=https://127.0.0.1

# Security SSL Redirect (Set to True in production behind HTTPS reverse proxy)
SECURE_SSL_REDIRECT=False
